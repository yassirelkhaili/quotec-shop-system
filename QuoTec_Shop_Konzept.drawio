tyle="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFF2CC;strokeColor=#D6B656;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010.0" y="120.0" width="180.0" height="130.0" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;storage/app/private/orders/*.json&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;Bestelldateien (Aufgabe 4)&lt;/span&gt;" style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1010.0" y="320.0" width="240.0" height="90.0" as="geometry"/></mxCell><mxCell id="c18" value="Inertia&lt;br&gt;(Props / POST)" style="endArrow=block;startArrow=block;endFill=1;startFill=1;html=1;fontSize=11;strokeWidth=1.5;exitX=1;exitY=0.4;entryX=0;entryY=0.2;" edge="1" parent="1" source="c3" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="Eloquent ORM" style="endArrow=block;startArrow=block;endFill=1;startFill=1;html=1;fontSize=11;strokeWidth=1.5;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="Storage::put()" style="endArrow=block;endFill=1;html=1;fontSize=11;strokeWidth=1.5;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="c9" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="&lt;b&gt;Projektstruktur&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;pre style='margin:0;font-size:11px;line-height:1.35'&gt;shop/  (Laravel)&#10;├── app/&#10;│   ├── Http/Controllers/  ShopController, OrderController&#10;│   ├── Http/Requests/     StoreOrderRequest&#10;│   └── Models/            Category, Product, Order,&#10;│                          OrderItem (+ User vom Kit)&#10;├── database/&#10;│   ├── migrations/        Tabellen (siehe ERD)&#10;│   ├── factories/         Category-, ProductFactory&#10;│   └── seeders/           ShopSeeder&#10;├── resources/js/&#10;│   ├── pages/home.tsx&#10;│   └── components/app-logo-icon.tsx&#10;├── routes/web.php&#10;├── storage/app/private/orders/  Bestelldateien (Aufg. 4)&#10;└── .env                   DB_USERNAME=root, DB_PASSWORD=0000&lt;/pre&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FAFAFA;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="530.0" width="560.0" height="320.0" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Begründung&lt;/b&gt;&lt;ul style='margin:6px 0 0 -16px'&gt;&lt;li&gt;Laravel ist ein allgemeines Framework, kein Shopsystem: erlaubt laut Aufgabe.&lt;/li&gt;&lt;li&gt;MVC trennt Darstellung, Logik und Daten; jede Schicht einzeln testbar.&lt;/li&gt;&lt;li&gt;Laravel React Starter Kit: Login, Registrierung und Profil sind fertig; der Shop nutzt dieselben Komponenten.&lt;/li&gt;&lt;li&gt;Inertia übergibt Produkte direkt als Props: keine eigene JSON-API und kein fetch nötig.&lt;/li&gt;&lt;li&gt;Bestellen nur mit Login: jedes Konto erhält automatisch eine Kundennummer.&lt;/li&gt;&lt;li&gt;Paginierung serverseitig (8 Produkte je Seite), sortiert nach Kategoriebaum.&lt;/li&gt;&lt;li&gt;Migrations machen das Schema reproduzierbar; Seeder liefert ≥ 4 Produkte.&lt;/li&gt;&lt;li&gt;Server lädt Preise und Bestand selbst aus der DB; Form Request validiert die Eingaben.&lt;/li&gt;&lt;li&gt;Zwischenstände als Git-Commits mit Tag je Aufgabe (aufgabe-1 … aufgabe-7).&lt;/li&gt;&lt;/ul&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FAFAFA;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640.0" y="530.0" width="550.0" height="235.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="Projektstrukturplan"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:20px'&gt;Projektstrukturplan (PSP) – phasenorientiert, 360 Minuten&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555555'&gt;Yassir Elkhaili · Probeaufgabe QuoTec GmbH · Online-Shop&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="20.0" width="1000.0" height="50.0" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Online-Shop&lt;/b&gt;&lt;br&gt;Probeaufgabe QuoTec · 360 min (6 h)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1F5E8C;strokeColor=#1F5E8C;fontColor=#FFFFFF;fontFamily=Helvetica;fontSize=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="510.0" y="100.0" width="300.0" height="60.0" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;1 Planung &amp; Einrichtung&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;60 min&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="230.0" width="280.0" height="56.0" as="geometry"/></mxCell><mxCell id="c5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c6" value="&lt;b&gt;1.1&lt;/b&gt;&amp;nbsp; Anforderungsanalyse &amp; Konzept&lt;br&gt;&lt;span style='font-size:11px;color:#555555'&gt;20 min · Netzplan-Vorgang A&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="66.0" y="320.0" width="254.0" height="58.