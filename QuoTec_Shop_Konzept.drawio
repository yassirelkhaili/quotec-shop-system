 value="Kategorie im Baum wählen:&lt;br&gt;Produkte inkl. Unterkategorien" style="rounded=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="715.0" y="512.0" width="270.0" height="56.0" as="geometry"/></mxCell><mxCell id="c11" value="Andere Seite&lt;br&gt;ansehen?" style="rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395.0" y="620.0" width="210.0" height="100.0" as="geometry"/></mxCell><mxCell id="c12" value="Seite wechseln (Paginierung),&lt;br&gt;Warenkorb bleibt erhalten" style="rounded=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="715.0" y="642.0" width="270.0" height="56.0" as="geometry"/></mxCell><mxCell id="c13" value="„In den Warenkorb“ klicken&lt;br&gt;oder Menge ändern (+ / − / Eingabe)" style="rounded=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="762.0" width="270.0" height="56.0" as="geometry"/></mxCell><mxCell id="c14" value="Menge größer als&lt;br&gt;Bestand?" style="rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395.0" y="850.0" width="210.0" height="100.0" as="geometry"/></mxCell><mxCell id="c15" value="Menge auf verfügbaren Bestand&lt;br&gt;begrenzen, Hinweis anzeigen" style="rounded=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="715.0" y="872.0" width="270.0" height="56.0" as="geometry"/></mxCell><mxCell id="c16" value="Warenkorb neu berechnen:&lt;br&gt;Zwischensummen, Netto, MwSt. 19 %, Brutto" style="rounded=1;arcSize=12;fillColor=#D5E8D4;strokeColor=#82B366;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350.0" y="992.0" width="300.0" height="56.0" as="geometry"/></mxCell><mxCell id="c17" value="Weiter&lt;br&gt;einkaufen?" style="rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="395.0" y="1080.0" width="210.0" height="100.0" as="geometry"/></mxCell><mxCell id="c18" value="Angemeldet?" style="rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="410.0" y="1205.0" width="180.0" height="90.0" as="geometry"/></mxCell><mxCell id="c19" value="Anmelden oder registrieren&lt;br&gt;(neue Kunden erhalten automatisch&lt;br&gt;eine Kundennummer), Warenkorb bleibt" style="rounded=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700.0" y="1215.0" width="300.0" height="70.0" as="geometry"/></mxCell><mxCell id="c20" value="Kundennummer eingeben&lt;br&gt;(mit eigener Nummer vorausgefüllt)" style="rounded=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="1342.0" width="270.0" height="56.0" as="geometry"/></mxCell><mxCell id="c21" value="„Bestellung absenden“ klicken" style="rounded=1;arcSize=12;fillColor=#DAE8FC;strokeColor=#6C8EBF;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="365.0" y="1432.0" width="270.0" height="56.0" as="geometry"/></mxCell><mxCell id="c22" value="Kundennummer&lt;br&gt;gehört zum Konto?&lt;br&gt;(Server prüft)" style="rhombus;fillColor=#FFF2CC;strokeColor=#D6B656;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="380.0" y="1530.0" width="240.0" height="120.0" as="geometry"/></mxCell><mxCell id="c23" value="Fehle