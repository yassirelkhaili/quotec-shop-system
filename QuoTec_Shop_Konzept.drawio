ll id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#555555;exitX=0.0429;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c22" target="c28"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="672" y="497"/></Array></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;4 Abschluss&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px'&gt;35 min&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970.0" y="230.0" width="280.0" height="56.0" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#555555;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;4.1&lt;/b&gt;&amp;nbsp; Funktionstest&lt;br&gt;&lt;span style='font-size:11px;color:#555555'&gt;20 min · Netzplan-Vorgang I&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="996.0" y="320.0" width="254.0" height="58.0" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#555555;exitX=0.0429;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c30" target="c32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="982" y="349"/></Array></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;4.2&lt;/b&gt;&amp;nbsp; Dokumentation &amp; Begründungen&lt;br&gt;&lt;span style='font-size:11px;color:#555555'&gt;15 min · Netzplan-Vorgang I&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#6C8EBF;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="996.0" y="394.0" width="254.0" height="58.0" as="geometry"/></mxCell><mxCell id="c35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;strokeColor=#555555;exitX=0.0429;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="c30" target="c34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="982" y="423"/></Array></mxGeometry></mxCell><mxCell id="c36" value="&lt;b&gt;Hinweise&lt;/b&gt;&lt;ul style='margin:6px 0 0 -16px'&gt;&lt;li&gt;Ebene 1: Teilprojekte nach Phasen (entspricht der vorgegebenen Reihenfolge der Aufgaben).&lt;/li&gt;&lt;li&gt;Ebene 2: Arbeitspakete mit Aufwand in Minuten; Summe = 360 min.&lt;/li&gt;&lt;li&gt;Die Buchstaben A–I verweisen auf die Vorgänge im Netzplan.&lt;/li&gt;&lt;li&gt;PHP (Laravel) ist ab Arbeitspaket 2.2 Pflicht, MySQL ab 3.1.&lt;/li&gt;&lt;/ul&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FAFAFA;strokeColor=#999999;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="650.0" width="600.0" height="130.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p2" name="Ablaufdiagramm (Nutzer)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="2110" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style='font-size:20px'&gt;Ablaufdiagramm – Einkauf aus Sicht des Nutzers&lt;/b&gt;&lt;br&gt;&lt;span style='color:#555555'&gt;Yassir Elkhaili · Probeaufgabe QuoTec GmbH · Online-Shop&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="20.0" width="1000.0" height="50.0" as="geometry"/></mxCell><mxCell id="c3" value="Start&lt;br&gt;Nutzer öffnet den Shop" style="ellipse;fillColor=#F5F5F5;strokeColor=